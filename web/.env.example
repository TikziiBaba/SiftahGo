# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda: PayTR ödeme bildirimini işlemek için (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (görsel yükleme)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Bucket'ın herkese açık adresi (r2.dev veya özel alan adı)
CLOUDFLARE_R2_PUBLIC_URL=

# Sitenin adresi (QR kodda kullanılır), örn. https://siftahgo.com
NEXT_PUBLIC_APP_URL=

# PayTR (Mağaza Paneli > Bilgi): ödeme almak için
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test ödemesi (canlı mağazada deneme için), 0 = gerçek ödeme
PAYTR_TEST_MODE=1
