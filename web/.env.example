# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda: PayTR ödeme bildirimini işlemek için (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (görsel yükleme)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Bucket'ın herkese açık adresi (r2.dev veya özel alan adı)
CLOUDFLARE_R2_PUBLIC_URL=

# Sitenin adresi (QR kodda kullanılır), örn. https://siftahgo.com
NEXT_PUBLIC_APP_URL=

# PayTR (Mağaza Paneli > Bilgi): ödeme almak için
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test ödemesi (canlı mağazada deneme için), 0 = gerçek ödeme
PAYTR_TEST_MODE=1

# Resend (randevu e-postaları): resend.com > API Keys. Gönderen adres doğrulanmış alan adınızdan olmalı.
RESEND_API_KEY=
EMAIL_FROM=SiftahGo <bildirim@ALAN-ADINIZ>
# /api/notifications'ı çağıran zamanlanmış görevin anahtarı (uzun, rastgele bir metin)
CRON_SECRET=

# Mobil uygulama indirme bağlantıları (sitede "Uygulamayı indir" bölümü). Boş olan "Yakında" görünür.
# Android APK: EAS ile derlenen dosyanın herkese açık adresi (örn. R2: https://.../app/siftahgo.apk)
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
